# Copy to .env and edit before running docker compose up.

# ── API access ────────────────────────────────────────────────────────────────
# NOTE: Vite inlines this key into the JavaScript bundle at build time, so it is
# readable by anyone who loads the dashboard. It gates casual access, not a
# determined attacker. Do not reuse a password you care about, and do not expose
# a deployment holding sensitive data to the public internet on this alone.
SENTINEL_API_KEY=change-me

# Browser origins allowed to call the API (comma-separated).
SENTINEL_ORIGINS=http://localhost:5173

# Base URL the built frontend will call. Must be reachable from the browser,
# not from inside the container network.
SENTINEL_PUBLIC_API=http://localhost:8000

# ── Demo traffic ──────────────────────────────────────────────────────────────
# 1 = generate ambient simulated attacks so the dashboard is never empty.
# 0 = show only what the honeypots actually observed.
# Simulated events are always tagged source="simulator" and labelled SIM in the
# UI; they are never presented as real observations.
SENTINEL_LIVE_ATTACKS=1
SENTINEL_LIVE_INTERVAL=1.6

# 1 = if the events table is empty at boot, load 7 days of demo history.
# Required on hosts with an ephemeral disk (Koyeb free, Render free) so a
# cold start does not open an empty dashboard. Leave at 0 on a persistent volume.
SENTINEL_SEED_ON_EMPTY=0

# ── Storage ───────────────────────────────────────────────────────────────────
SENTINEL_DB=/data/sentinel.db
